# Valores públicos incluidos en la variante Windows de control.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Una clave: use ENOTARIO_CONTROL_LEASE_KEY_ID y ENOTARIO_CONTROL_LEASE_PUBLIC_KEY.
# Durante una rotación, use ENOTARIO_CONTROL_LEASE_PUBLIC_KEYS con hasta tres pares:
# ENOTARIO_CONTROL_LEASE_PUBLIC_KEYS=2026-01=BASE64URL_32_BYTES;2026-02=BASE64URL_32_BYTES
# Se pasan al proceso de compilación de Tauri, no a Vite.
